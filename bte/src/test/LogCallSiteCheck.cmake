# cmake -DTOOL=<objdump or llvm-objdump> -DOBJECT=<LogCallSites object> [-DEXTRA_ALLOWED=<symbol>] -P <this file>
# Fails when a logCallSite function reads the counter other than once inline (none when kLogMode 0 leaves it a bare
# return), or calls or jumps anywhere but LOG's cold paths, logSlow and commitAfterRepeats; or when a logCallSiteOne
# function, whose record has text or a custom type, reads the counter or makes other than exactly one call
cmake_minimum_required(VERSION 3.28) # without it, -P runs the script with CMake's old policies and no IN_LIST

macro(objdumpLines var)
  execute_process(COMMAND "${TOOL}" ${ARGN} "${OBJECT}" OUTPUT_VARIABLE out RESULT_VARIABLE rc)
  if (NOT rc EQUAL 0)
    message(FATAL_ERROR "LogCallSiteCheck: ${TOOL} failed on ${OBJECT}")
  endif()
  # Brackets and semicolons would break CMake's list of lines
  string(REPLACE ";" "," out "${out}")
  string(REPLACE "[" "(" out "${out}")
  string(REPLACE "]" ")" out "${out}")
  string(REPLACE "\n" ";" ${var} "${out}")
endmacro()

# No name may contain another: a function's header is matched against the names in this order
set(zeroCallSites logCallSiteLiteral logCallSiteNumbers logCallSiteQuotedArg logCallSitePointer logCallSiteArgs)
set(oneCallSites logCallSiteOneText logCallSiteOneString logCallSiteOneLone logCallSiteOneCustom logCallSiteOneLlog
    logCallSiteOneStdString logCallSiteOneWholeString logCallSiteOneCStr)
list(JOIN zeroCallSites "|" zeroPattern)
list(JOIN oneCallSites "|" onePattern)
set(sitePattern "${zeroPattern}|${onePattern}")

# A Mach-O disassembly names the function at the start of a section by its local label, <ltmp0>
objdumpLines(symbols -t)
foreach (line IN LISTS symbols)
  if (line MATCHES "^([0-9a-f]+) .*[ \t]_?(${sitePattern})$")
    set("symbolAt_${CMAKE_MATCH_1}" "${CMAKE_MATCH_2}")
  endif()
endforeach()
objdumpLines(lines -d -r --no-show-raw-insn)

set(allowed "logSlow|commitAfterRepeats")
# The stack checks of MSVC's /GS and of a distribution's default stack protector, and the format argument index ARM64
# MSVC does not inline
set(oneCallAllowed "__security_(push|pop|check)_cookie|__stack_chk_fail|_Format_arg_index@std@@")
if (EXTRA_ALLOWED)
  string(APPEND allowed "|${EXTRA_ALLOWED}")
  string(APPEND oneCallAllowed "|${EXTRA_ALLOWED}")
endif()

# A call or jump to the function itself, its cold part or a local label (MSVC's $LN11, Mach-O's ltmp0) is no call out;
# a one-call function counts the other targets, each once, as each of its paths ends in the same call; a zero-call
# function allows only LOG's own cold paths
macro(callOut target)
  if (NOT "${target}" MATCHES "${base}|^\\$|^ltmp[0-9]+$")
    if (oneCall)
      if (NOT "${target}" MATCHES "${oneCallAllowed}")
        list(APPEND "targets_${base}" "${target}")
      endif()
    elseif (NOT "${target}" MATCHES "${allowed}")
      list(APPEND failures "${function}: ${pendingOp} to ${target}")
    endif()
  endif()
endmacro()

macro(checkPending)
  if (NOT pendingOp STREQUAL "")
    callOut("${pendingTarget}")
    set(pendingOp "")
  endif()
endmacro()

set(function "")
set(found "")
set(failures "")
set(pendingOp "")
foreach (line IN LISTS lines)
  # "0000000000000000 <logCallSiteNumbers>:", or <_logCallSiteNumbers> and <logCallSiteNumbers.cold>; MSVC's labels
  # inside a function, <$LN11>, belong to it
  if (line MATCHES "^([0-9a-f]+) <([^$>][^>]*)>:$")
    set(address "${CMAKE_MATCH_1}")
    set(name "${CMAKE_MATCH_2}")
    if (name MATCHES "^ltmp[0-9]+$" AND DEFINED "symbolAt_${address}")
      set(name "${symbolAt_${address}}")
    endif()
    checkPending()
    set(function "")
    set(tlvLoaded FALSE)
    set(firstOp "")
    # x86 MSVC's unwind handler of a site, <__ehhandler$_logCallSiteOneCustom>, is not on its path
    if (name MATCHES "^__ehhandler")
      continue()
    endif()
    if (name MATCHES "(${sitePattern})")
      set(function "${name}")
      set(base "${CMAKE_MATCH_1}")
      if (base IN_LIST oneCallSites)
        set(oneCall TRUE)
      else()
        set(oneCall FALSE)
      endif()
      if (NOT base IN_LIST found)
        list(APPEND found "${base}")
        set("reads_${base}" 0)
        set("targets_${base}" "")
        set("bareReturn_${base}" FALSE)
      endif()
    endif()
    continue()
  endif()
  if (function STREQUAL "")
    continue()
  endif()

  # The relocation written after a call or a jump names its real target
  if (line MATCHES "^[ \t]+[0-9a-f]+:[ \t]+([A-Z][A-Z0-9_]*)[ \t]+([^ \t]+)$")
    set(target "${CMAKE_MATCH_2}")
    if (CMAKE_MATCH_1 MATCHES "TLVP_LOAD_PAGEOFF12")
      set(tlvLoaded TRUE)
    endif()
    if (NOT pendingOp STREQUAL "")
      callOut("${target}")
    endif()
    set(pendingOp "")
    continue()
  endif()
  if (NOT line MATCHES "^[ \t]+[0-9a-f]+:[ \t]+([a-z][a-z0-9.]*)[ \t]*(.*)$")
    continue()
  endif()
  set(op "${CMAKE_MATCH_1}")
  set(args "${CMAKE_MATCH_2}")
  if (firstOp STREQUAL "" AND NOT op MATCHES "^(endbr64|endbr32|bti)$")
    set(firstOp "${op}")
    if (op MATCHES "^ret" AND NOT function MATCHES "\\.cold")
      set("bareReturn_${base}" TRUE)
    endif()
  endif()

  checkPending()
  if (op STREQUAL "rdtsc" OR (op STREQUAL "mrs" AND args MATCHES "(cntvct|CNTVCT)_(el0|EL0)"))
    math(EXPR "reads_${base}" "${reads_${base}} + 1")
  elseif (op STREQUAL "blr" AND tlvLoaded)
    # macOS reads a thread_local through the getter its descriptor holds
    set(tlvLoaded FALSE)
  elseif (op MATCHES "^(blr|br)$" OR (op MATCHES "^(call|calll|callq|jmp|jmpl|jmpq)$" AND args MATCHES "^\\*"))
    list(APPEND failures "${function}: indirect ${op} ${args}")
  elseif (op MATCHES "^(call|calll|callq|jmp|jmpl|jmpq|bl|b)$" AND args MATCHES "^(0x)?[0-9a-f]+ <([^>+]+)")
    set(pendingOp "${op}")
    set(pendingTarget "${CMAKE_MATCH_2}")
  endif()
endforeach()
checkPending()

foreach (base IN LISTS zeroCallSites)
  if (NOT base IN_LIST found)
    list(APPEND failures "${base}: not in ${OBJECT}")
  elseif (NOT reads_${base} EQUAL 1 AND NOT (reads_${base} EQUAL 0 AND bareReturn_${base}))
    list(APPEND failures "${base}: ${reads_${base}} counter reads, not one")
  endif()
endforeach()
foreach (base IN LISTS oneCallSites)
  set(targets "${targets_${base}}")
  list(REMOVE_DUPLICATES targets)
  list(LENGTH targets calls)
  list(JOIN targets ", " called)
  if (NOT base IN_LIST found)
    list(APPEND failures "${base}: not in ${OBJECT}")
  elseif (NOT reads_${base} EQUAL 0)
    list(APPEND failures "${base}: ${reads_${base}} counter reads, not none")
  elseif (NOT calls EQUAL 1 AND NOT (calls EQUAL 0 AND bareReturn_${base}))
    list(APPEND failures "${base}: calls ${calls} functions, not one: ${called}")
  endif()
endforeach()
if (failures)
  list(REMOVE_DUPLICATES failures)
  list(JOIN failures "\n  " text)
  message(FATAL_ERROR "A LOG call site calls out of its fast path:\n  ${text}")
endif()
